# MCP server. The bearer value is never sent to the browser.
MCP_SERVER_URL=https://rag-timer-00001-production.up.railway.app/mcp/
MCP_API_TOKEN=

# Novita chat. The key name contains hyphens; set it in the Railway dashboard.
# Shell export cannot use this name.
LLM_BASE_URL=https://api.novita.ai/openai/v1
LLM_MODEL=google/gemma-3-27b-it
LLM_MODEL_FALLBACK=google/gemma-3-12b-it
NOVITA_LLM_API_KEY_GEMMA-3-27=
ANSWER_USE_LLM=true
ANSWER_CACHE_TTL_SECONDS=600

# Google sign-in. Every page and /api route requires a session.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=marek@example.com
SESSION_SECRET=replace-with-a-long-random-string
PUBLIC_BASE_URL=https://fastmcp-rag-timer-frontend-production.up.railway.app

HOST=0.0.0.0
PORT=8000
